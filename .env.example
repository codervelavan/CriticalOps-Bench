# Optional configuration. The prototype works without an LLM API key.
CRITICALOPS_DB_PATH=data/workbench.sqlite
CRITICALOPS_RETRIEVAL_MODE=keyword-baseline

# Optional OpenAI-compatible chat-completions API. Leave blank to use offline templates.
# Set LLM_BASE_URL to the provider's API base (usually ending in /v1), LLM_API_KEY to a secret,
# and LLM_MODEL to the specific model/deployment name available to your account.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
