        "lineageTag": "1b07604a-7229-4b90-9f0b-2d5266c86b9a",
        "measures": [
          {
            "name": "Synthetic Cases",
            "description": "Synthetic evaluation cases only; not production performance.",
            "expression": "COUNTROWS(Incidents)",
            "formatString": "0",
            "lineageTag": "e2277934-251f-462b-b933-8e5e4184951e"
          },
          {
            "name": "Category Exact Match",
            "description": "Synthetic evaluation cases only; not production performance.",
            "expression": "DIVIDE(COALESCE(CALCULATE(COUNTROWS(Incidents), Incidents[category_pass] = TRUE()), 0), [Synthetic Cases])",
            "formatString": "0.0%",
            "lineageTag": "906b4f45-fc24-4f67-a709-f1057b9721d3"
          },
          {
            "name": "Priority Exact Match",
            "description": "Synthetic evaluation cases only; not production performance.",
            "expression": "DIVIDE(COALESCE(CALCULATE(COUNTROWS(Incidents), Incidents[priority_pass] = TRUE()), 0), [Synthetic Cases])",
            "formatString": "0.0%",
            "lineageTag": "f7fee6f6-4350-44a0-bf68-ac8368fe340d"
          },
          {
            "name": "Safety Routing Pass",
            "description": "Synthetic evaluation cases only; not production performance.",
            "expression": "DIVIDE(CALCULATE(COUNTROWS(Incidents), Incidents[safety_expected] = TRUE(), Incidents[safety_escalation_pass] = TRUE()), CALCULATE(COUNTROWS(Incidents), Incidents[safety_expected] = TRUE()))",
            "formatString": "0.0%",
            "lineageTag": "1377aea9-217b-4945-a8cd-e3310a5285fe"
          },
          {
            "name": "Fallback Rate",
            "description": "Synthetic evaluation cases only; not production performance.",
            "expression": "DIVIDE(COALESCE(CALCULATE(COUNTROWS(Incidents), Incidents[fallback_used] = TRUE()), 0), [Synthetic Cases])",
            "formatString": "0.0%",
            "lineageTag": "92f79783-8e22-4d04-a775-41fa26954b24"
          },
          {
            "name": "Mismatch Cases",
            "description": "Synthetic evaluation cases only; not production performance.",
            "expression": "COALESCE(CALCULATE(COUNTROWS(Incidents), Incidents[evaluation_result] = \"Mismatch\"), 0)",
            "formatString": "0",
            "lineageTag": "8b6fd23a-15d4-4c25-8615-7c814c4c6209"
          }
        ],
        "partitions": [
          {
            "name": "SyntheticSnapshot",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "// Embedded snapshot of the public synthetic CSV: portable and no credentials required.",
                "    Source = Csv.Document(Binary.FromText(\"\", BinaryEncoding.Base64), [Delimiter=\",\", Columns=20, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Booleans = Table.TransformColumns(Headers, {{\"category_pass\", each if Text.Lower(Text.Trim(_)) = \"true\" then true else if Text.Lower(Text.Trim(_)) = \"false\" then false else null, type logical}, {\"fallback_used\", each if Text.Lower(Text.Trim(_)) = \"true\" then true else if Text.Lower(Text.Trim(_)) = \"false\" then false else null, type logical}, {\"priority_pass\", each if Text.Lower(Text.Trim(_)) = \"true\" then true else if Text.Lower(Text.Trim(_)) = \"false\" then false else null, type logical}, {\"safety_escalation_pass\", each if Text.Lower(Text.Trim(_)) = \"true\" then true else if Text.Lower(Text.Trim(_)) = \"false\" then false else null, type logical}, {\"safety_expected\", each if Text.Lower(Text.Trim(_)) = \"true\" then true else if Text.Lower(Text.Trim(_)) = \"false\" then false else null, type logical}}),",
                "    Typed = Table.TransformColumnTypes(Booleans, {{\"created_date\", type date}, {\"production_impact\", Int64.Type}, {\"downtime_hours\", type number}, {\"retrieval_confidence\", type number}}, \"en-US\"),",
                "    CleanIDs = Table.TransformColumns(Typed, {{\"incident_id\", Text.Trim, type text}, {\"site\", Text.Trim, type text}}),",
                "    Evaluation = Table.AddColumn(CleanIDs, \"evaluation_result\", each if [category_pass] = true and [priority_pass] = true then \"Match\" else \"Mismatch\", type text)",
                "in",
                "    Evaluation"
              ],
              "type": "m"
            }
          }
        ]
      },
